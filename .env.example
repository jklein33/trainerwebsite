# Supabase: use a dedicated test project while developing.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Stripe: test keys first. Webhook URL: /api/stripe/webhook
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Optional mapping for the existing /checkout link; must match a published course's price.
NEXT_PUBLIC_STRIPE_PRICE_ID=

# Optional absolute URLs when the main website and course room use different hosts.
NEXT_PUBLIC_SITE_URL=
NEXT_PUBLIC_COURSE_URL=

# Existing contact form (separate from Supabase Auth's SMTP settings).
RESEND_API_KEY=
RESEND_FROM_EMAIL=
CONTACT_EMAIL=
